# UFW backend integration-test image (AGENTS.md follow-up #4).
#
# Builds the fw-agent container_backends test binary in a glibc-compatible
# stage (bookworm 2.36) and runs it on ubuntu:24.04, where the real
# `ufw`/`iptables` tooling executes with --cap-add=NET_ADMIN. A host-built
# binary would not work here: the dev box glibc is newer than the image's, so
# the binary is compiled inside the image instead.
#
# Build context is the repo root:
#   docker build -q -f scripts/itest/Dockerfile.ufw .
#   docker run --rm --cap-add=NET_ADMIN -e LHFM_ITEST_INNER=1 <img> \
#       lhfm-itest it_ufw_ --test-threads=1 --nocapture
#
# The cargo registry is a BuildKit cache mount so dependency compilation is
# cached across image builds; only workspace crates recompile on code changes.

# syntax=docker/dockerfile:1
FROM rust:1-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY migrations ./migrations
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --tests -p fw-agent --test container_backends
# The deps dir holds both the binary and its .d metadata, and a multi-source
# COPY into a single path would create a directory — pick the executable only.
RUN cp "$(find target/debug/deps -maxdepth 1 -name 'container_backends-*' ! -name '*.d' | head -1)" \
    /build/lhfm-itest

FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends ufw iptables \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/lhfm-itest /usr/local/bin/lhfm-itest
ENTRYPOINT ["lhfm-itest"]